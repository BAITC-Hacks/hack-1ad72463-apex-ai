# Local development only. PostgreSQL is exposed on loopback by compose.yaml.
DATABASE_URL='postgres://hackalem:hackalem_local@127.0.0.1:54329/hackalem?sslmode=disable'
HTTP_ADDR=':8080'
CORS_ORIGINS='http://localhost:3000,http://localhost:5173'
CATALOG_CSV='data/catalog.csv'
CATALOG_META='data/catalog.meta.json'
CATALOG_FACTS='data/facts.json'
# Set CATALOG_FACTS='-' for structured-only explanations without curated facts.
# Integration tests create and remove their own schema, never existing tables.
TEST_DATABASE_URL='postgres://hackalem:hackalem_local@127.0.0.1:54329/hackalem?sslmode=disable'
